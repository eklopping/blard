# Production: set DOMAIN=arsperita.com (DNS A/AAAA → this VM).
# Caddy obtains a Let's Encrypt certificate automatically on :443.
# Local/IP-only: set DOMAIN=localhost (HTTP only; LE will not issue for IPs).
#
# Prefer HTTP-01 (port 80) over TLS-ALPN-01 — ALPN often fails behind
# cloud NATs, CDNs, or when something else terminates 443.
# Certs persist in the caddy_data Docker volume.
#
# Do not put `email {$ACME_EMAIL}` here unless ACME_EMAIL is always non-empty —
# an empty placeholder makes Caddy fail to start ("wrong argument count").

{
	# Force HTTP-01 on :80 (compatible with Caddy 2.x ACME issuer syntax)
	cert_issuer acme {
		disable_tlsalpn_challenge
	}
}

{$DOMAIN:localhost} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:3001
	}

	# Colyseus HTTP matchmaking
	handle /matchmake* {
		reverse_proxy game-server:2567
	}

	# Colyseus room WebSockets (Upgrade) — must not hit file_server
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy game-server:2567
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
